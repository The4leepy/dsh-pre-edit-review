{
  "name": "dsh-pre-edit-review",
  "version": "0.2.1",
  "type": "module",
  "description": "Unofficial community DSH Host plugin: intercept agent file writes, stage them, and only commit after the user accepts an editable diff in VS Code.",
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/The4leepy/dsh-pre-edit-review"
  },
  "homepage": "https://github.com/The4leepy/dsh-pre-edit-review#readme",
  "bugs": {
    "url": "https://github.com/The4leepy/dsh-pre-edit-review/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "code-review",
    "diff",
    "agent",
    "approval",
    "safety"
  ],
  "author": {
    "name": "The4leepy"
  },
  "publishConfig": {
    "access": "public"
  }
}
