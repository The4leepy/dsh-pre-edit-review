{
  "name": "deepseek-pre-edit-review",
  "displayName": "DeepSeek Pre-edit Review",
  "description": "Review and edit agent-proposed file changes in an editable VS Code diff before anything is written to disk.",
  "publisher": "The-4leepy",
  "version": "0.2.2",
  "private": true,
  "engines": {
    "vscode": "^1.145.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dpr",
          "title": "%viewContainer.dpr%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dpr": [
        {
          "id": "dpr.pendingView",
          "name": "%view.pending%"
        },
        {
          "id": "dpr.historyView",
          "name": "%view.history%"
        }
      ]
    },
    "commands": [
      {
        "command": "dpr.accept",
        "title": "%command.accept%",
        "icon": "$(check)"
      },
      {
        "command": "dpr.reject",
        "title": "%command.reject%",
        "icon": "$(close)"
      },
      {
        "command": "dpr.acceptItem",
        "title": "%command.acceptItem%",
        "icon": "$(check)"
      },
      {
        "command": "dpr.rejectItem",
        "title": "%command.rejectItem%",
        "icon": "$(close)"
      },
      {
        "command": "dpr.openItem",
        "title": "%command.openItem%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dpr.showPending",
        "title": "%command.showPending%"
      },
      {
        "command": "dpr.reconnect",
        "title": "%command.reconnect%"
      },
      {
        "command": "dpr.acceptAll",
        "title": "%command.acceptAll%",
        "icon": "$(check-all)"
      },
      {
        "command": "dpr.rejectAll",
        "title": "%command.rejectAll%",
        "icon": "$(close-all)"
      },
      {
        "command": "dpr.clearHistory",
        "title": "%command.clearHistory%",
        "icon": "$(trash)"
      },
      {
        "command": "dpr.runSelfTest",
        "title": "%command.runSelfTest%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dpr.reject",
          "when": "dpr.activeProposal && dpr.hasPending",
          "group": "navigation@1",
          "icon": "$(close)"
        },
        {
          "command": "dpr.accept",
          "when": "dpr.activeProposal && dpr.hasPending",
          "group": "navigation@2",
          "icon": "$(check)"
        }
      ],
      "view/title": [
        {
          "command": "dpr.acceptAll",
          "when": "view == dpr.pendingView",
          "group": "navigation@1"
        },
        {
          "command": "dpr.rejectAll",
          "when": "view == dpr.pendingView",
          "group": "navigation@2"
        },
        {
          "command": "dpr.clearHistory",
          "when": "view == dpr.historyView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dpr.acceptItem",
          "when": "view == dpr.pendingView && viewItem == pendingReview",
          "group": "inline"
        },
        {
          "command": "dpr.rejectItem",
          "when": "view == dpr.pendingView && viewItem == pendingReview",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "dpr.accept",
          "when": "dpr.hasPending"
        },
        {
          "command": "dpr.reject",
          "when": "dpr.hasPending"
        },
        {
          "command": "dpr.acceptItem",
          "when": "false"
        },
        {
          "command": "dpr.rejectItem",
          "when": "false"
        },
        {
          "command": "dpr.openItem",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dpr.accept",
        "key": "ctrl+alt+enter",
        "mac": "ctrl+alt+enter",
        "when": "dpr.hasPending && (dpr.activeProposal || editorFocus || resourceScheme == 'dpr' || focusedView == 'dpr.pendingView')"
      },
      {
        "command": "dpr.reject",
        "key": "ctrl+alt+backspace",
        "mac": "ctrl+alt+backspace",
        "when": "dpr.hasPending && (dpr.activeProposal || editorFocus || resourceScheme == 'dpr' || focusedView == 'dpr.pendingView')"
      }
    ],
    "configuration": {
      "title": "DeepSeek Pre-edit Review",
      "properties": {
        "dpr.stateDir": {
          "type": "string",
          "default": "~/.dsh/pre-edit-review",
          "description": "%config.stateDir%"
        },
        "dpr.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoConnect%"
        },
        "dpr.autoAccept": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoAccept%"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "license": "Apache-2.0"
}
