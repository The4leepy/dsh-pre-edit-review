{
  "name": "deepseek-pre-edit-review",
  "displayName": "DeepSeek Pre-edit Review",
  "description": "Review and edit agent-proposed file changes in an editable VS Code diff before anything is written to disk.",
  "publisher": "The-4leepy",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "vscode": "^1.145.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dpr.accept",
        "title": "%command.accept%",
        "icon": "$(check)"
      },
      {
        "command": "dpr.reject",
        "title": "%command.reject%",
        "icon": "$(close)"
      },
      {
        "command": "dpr.showPending",
        "title": "%command.showPending%"
      },
      {
        "command": "dpr.reconnect",
        "title": "%command.reconnect%"
      },
      {
        "command": "dpr.acceptAll",
        "title": "%command.acceptAll%"
      },
      {
        "command": "dpr.runSelfTest",
        "title": "%command.runSelfTest%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dpr.reject",
          "when": "dpr.activeProposal && dpr.hasPending",
          "group": "navigation@1",
          "icon": "$(close)"
        },
        {
          "command": "dpr.accept",
          "when": "dpr.activeProposal && dpr.hasPending",
          "group": "navigation@2",
          "icon": "$(check)"
        }
      ],
      "commandPalette": [
        {
          "command": "dpr.accept",
          "when": "dpr.hasPending"
        },
        {
          "command": "dpr.reject",
          "when": "dpr.hasPending"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dpr.accept",
        "key": "ctrl+alt+enter",
        "mac": "ctrl+alt+enter",
        "when": "resourceScheme == 'dpr'"
      },
      {
        "command": "dpr.reject",
        "key": "ctrl+alt+backspace",
        "mac": "ctrl+alt+backspace",
        "when": "resourceScheme == 'dpr'"
      }
    ],
    "configuration": {
      "title": "DeepSeek Pre-edit Review",
      "properties": {
        "dpr.stateDir": {
          "type": "string",
          "default": "~/.dsh/pre-edit-review",
          "description": "%config.stateDir%"
        },
        "dpr.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoConnect%"
        },
        "dpr.autoAccept": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoAccept%"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  }
}
